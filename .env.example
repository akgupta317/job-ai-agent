OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_S=120
THRIVESTACK_MCP_URL=https://api.app.thrivestack.ai/mcp
ALLOW_ENV_TOKEN=false
THRIVESTACK_MCP_TOKEN=
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
BATCH_SIZE=5
DEFAULT_MAX_PER_SIDE=5
MAX_EXISTING_TITLES=15
# Judge agent (quality review) and feedback loop
OLLAMA_JUDGE_MODEL=llama3.1:8b
JUDGE_BATCH_SIZE=3
JUDGE_MAX_LLM_ROWS=12
JUDGE_SAVED_LIMIT=200
FEEDBACK_MIN_DECIDED=5
FEEDBACK_MAX_DISMISSED=6
FEEDBACK_MAX_ACCEPTED=3
# Guardrails (there is no setting to turn them off)
MAX_QUESTION_CHARS=500
MAX_PROMPT_CHARS=40000
MAX_ANSWER_CHARS=3000
LLM_WAIT_S=30
